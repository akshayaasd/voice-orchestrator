# ─────────────────────────────────────────────────────────
# Voice Orchestrator — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── LLM Providers ─────────────────────────────────────────
# Gemini 1.5 Flash (Tier 2 / Tier 1 stack)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Llama 3.3 70B (Tier 2 — ultra-low latency)
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local dev / fallback — no key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── STT Providers ─────────────────────────────────────────
# Deepgram Nova-2 (Global English)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Sarvam Saaras (Indic languages — Hindi, Tamil, Telugu, etc.)
SARVAM_API_KEY=your_sarvam_api_key_here

# ── TTS Providers ─────────────────────────────────────────
# Sarvam Bulbul uses the same SARVAM_API_KEY above

# ── LiveKit (Media Server & Telephony Gateway) ────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Redis (2-Phase Slot Lock + VAD Buffer) ────────────────
REDIS_URL=redis://localhost:6379

# ── SMS — Exotel (India Primary) ──────────────────────────
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_FROM_NUMBER=your_exotel_virtual_number
EXOTEL_SUBDOMAIN=api.exotel.com
