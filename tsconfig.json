{
  "compilerOptions": {
    // Output
    "rootDir":  "./src",
    "outDir":   "./dist",

    // Module — CommonJS for Node.js compatibility with ts-node
    "module":           "CommonJS",
    "moduleResolution": "bundler",
    "target":           "ES2020",
    "lib":              ["ES2020"],
    "types":            ["node"],

    // Source maps for debugging
    "sourceMap":      true,
    "declaration":    true,
    "declarationMap": true,

    // Strict typechecking
    "strict":         true,
    "skipLibCheck":   true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // Interop
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
